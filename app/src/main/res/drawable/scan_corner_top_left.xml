<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 左上角 -->
    <item android:gravity="top|left" android:width="32dp" android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/miui_blue" />
            <corners android:topLeftRadius="4dp" />
        </shape>
    </item>
    <item android:gravity="top|left" android:width="4dp" android:height="32dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/miui_blue" />
            <corners android:topLeftRadius="4dp" />
        </shape>
    </item>
</layer-list>
